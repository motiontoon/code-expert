# ============================================
# Codex Forge - Environment Configuration
# ============================================

# Server
NODE_ENV=development
PORT=3000
SERVER_URL=http://localhost:3000
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL)
# Local: postgresql://user:password@localhost:5432/codex_forge
# Render: auto-injected from render.yaml
DATABASE_URL="postgresql://user:password@localhost:5432/codex_forge"

# Session & JWT
SESSION_SECRET=your-session-secret-change-in-production
JWT_SECRET=your-jwt-secret-change-in-production
JWT_EXPIRATION=7d

# GitHub OAuth
# Create at: https://github.com/settings/developers
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_CALLBACK_URL=http://localhost:3000/api/auth/github/callback

# AI Coding Engine
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key
AI_MODEL=claude-sonnet-4-5-20250929
AI_MAX_TOKENS=8192

# Redis (for task queue)
REDIS_URL=redis://localhost:6379

# File Guard
FILE_GUARD_ENABLED=true
FILE_GUARD_STRICT_MODE=true

# Logging
LOG_LEVEL=debug
